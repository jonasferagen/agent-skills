#!/usr/bin/env python3
"""Run a named service's start, stop, restart, status or logs control."""
import argparse
import os
from pathlib import Path
import sys


def main() -> int:
    home = Path(__file__).resolve().parent
    services = sorted(directory.name for directory in home.iterdir()
                      if directory.is_dir() and not directory.is_symlink()
                      and (directory / "control").is_file()
                      and not (directory / "control").is_symlink()
                      and os.access(directory / "control", os.X_OK))
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("service", choices=services)
    parser.add_argument("action", choices=("start", "stop", "restart", "status", "logs"))
    parser.add_argument("--root", type=Path, default=home.parent,
                        help="expected runtime checkout; defaults to this checkout")
    args = parser.parse_args()
    controller = home / args.service / "control"
    try:
        os.execv(str(controller), [str(controller), args.action, "--root", str(args.root)])
    except OSError as error:
        print(f"Cannot run {args.service} control: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
