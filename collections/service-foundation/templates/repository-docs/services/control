#!/usr/bin/env python3
"""Run a named service's start, stop, restart, status or logs control.

`status` without a service name reports every service in the project: this
checkout and each checkout named in the foundation References that has its own
services/control. `--scope checkout` narrows it to one checkout. Other actions
always name one service.

Reading is project-wide; starting and stopping stay checkout-local. A report is
asked of the installed checkout, not of the task worktree the command was run
from, because a worktree has no units or containers of its own: its controllers
would report instances that were never created while the real ones run elsewhere.
Bare status reports and does not assert health -- a service that is deliberately
not running is a row, not a failure -- so it exits nonzero only when a controller
could not be run at all.
"""
import argparse
import os
from pathlib import Path
import re
import subprocess
import sys

ACTIONS = ("start", "stop", "restart", "status", "logs")
SCOPES = ("workspace", "checkout")
REFERENCE = re.compile(r"^\|\s*([a-z0-9][a-z0-9-]*)\s*\|\s*([^|]+?)\s*\|\s*$")


def discover(home):
    return sorted(directory.name for directory in home.iterdir()
                  if directory.is_dir() and not directory.is_symlink()
                  and directory.name not in ACTIONS
                  and (directory / "control").is_file()
                  and not (directory / "control").is_symlink()
                  and os.access(directory / "control", os.X_OK))


def installed(home):
    """The checkout a service actually runs in, which is not a task worktree.

    A linked worktree shares its repository, so the common Git directory names the
    installed checkout from either place. Without this, a bare status run from a
    worktree asks every controller about units that checkout never created.
    """
    try:
        found = subprocess.run(["git", "-C", str(home), "rev-parse",
                                "--path-format=absolute", "--git-common-dir"],
                               stdin=subprocess.DEVNULL, capture_output=True,
                               text=True, timeout=20, check=True).stdout.strip()
    except (OSError, subprocess.SubprocessError):
        return home.parent
    root = Path(found).parent if found else home.parent
    return root if (root / "services/control").is_file() else home.parent


def references(checkout):
    """Checkouts named in this checkout's foundation References table."""
    foundation = checkout / "project-docs/foundation.md"
    try:
        text = foundation.read_text(encoding="utf-8")
    except OSError:
        return []
    section = re.search(r"^## References\s*$(.*?)(?=^## |\Z)", text, re.M | re.S)
    found = []
    for line in (section[1] if section else "").splitlines():
        match = REFERENCE.match(line)
        if match and match[1] != "key":
            found.append((match[1], (foundation.parent / match[2]).resolve()))
    return found


def status_all(home, root, options):
    """Report every service in one checkout. Nonzero only if a controller would not run.

    The child's own exit code is shown rather than judged: a deliberately
    unprovisioned environment and a start-when-asked service both exit nonzero
    while nothing is wrong, so folding those into one verdict would report a
    healthy project as broken every day and teach the reader to ignore it.
    """
    failed = 0
    for name in discover(home):
        controller = home / name / "control"
        try:
            result = subprocess.run([str(controller), "status", "--root", str(root), *options],
                                    stdin=subprocess.DEVNULL, capture_output=True,
                                    text=True, timeout=60)
        except (OSError, subprocess.SubprocessError) as error:
            print(f"{name}: controller would not run: {error}")
            failed = 1
            continue
        print(f"{name}: " + ("reports ready" if result.returncode == 0
                             else f"reports exit {result.returncode}"))
        for line in (result.stdout + result.stderr).splitlines():
            print("  " + line)
    return failed


def main() -> int:
    home = Path(__file__).resolve().parent
    services = discover(home)
    parser = argparse.ArgumentParser(
        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter,
        usage="%(prog)s SERVICE {start,stop,restart,status,logs} [--root ROOT]\n"
              "       %(prog)s status [--scope {workspace,checkout}] [--root ROOT]")
    parser.add_argument("target", metavar="SERVICE", help="one of: " + ", ".join(services))
    parser.add_argument("action", nargs="?", choices=ACTIONS)
    parser.add_argument("--root", type=Path, default=None,
                        help="expected runtime checkout; defaults to the installed checkout")
    parser.add_argument("--scope", choices=SCOPES, default="workspace",
                        help="with bare status, report the whole project or one checkout; "
                             "default workspace")
    args, options = parser.parse_known_args()
    if args.action is None:
        if args.target != "status":
            parser.error(f"name an action for {args.target!r}, or use bare status for every service")
        # Report the installed checkout, not this worktree, unless told otherwise.
        reporting = (args.root or installed(home)).resolve()
        entry = reporting / "services/control"
        local = entry.parent if entry.is_file() and reporting != home.parent else home
        failed = status_all(local, reporting, options)
        if args.scope == "checkout":
            return failed
        seen = {reporting}
        for key, checkout in references(reporting):
            sibling = checkout / "services/control"
            if checkout in seen:
                continue
            if not sibling.is_file() or not os.access(sibling, os.X_OK):
                # A declared member with no service home is stated, so no reader has to
                # wonder whether it was skipped by accident. A reference that is not a
                # repository at all, such as a content store, is not a member.
                if (checkout / "project-docs/foundation.md").is_file():
                    seen.add(checkout)
                    print(f"\n== {key} ({checkout})")
                    print("  no service home")
                continue
            seen.add(checkout)
            print(f"\n== {key} ({checkout})")
            sys.stdout.flush()
            try:
                reported = subprocess.run([str(sibling), "status", "--scope", "checkout"],
                                          stdin=subprocess.DEVNULL, timeout=600)
            except (OSError, subprocess.SubprocessError) as error:
                print(f"  controller would not run: {error}")
                failed = 1
                continue
            if reported.returncode:
                # A sibling still on an older dispatcher cannot take --scope; say so
                # plainly rather than leaving its usage error in the middle of a report.
                print(f"  reported exit {reported.returncode}"
                      " (a checkout on an older dispatcher cannot take --scope)")
        return failed
    if args.scope != "workspace":
        parser.error("--scope applies only to bare status")
    if args.target not in services:
        parser.error(f"argument SERVICE: invalid choice: {args.target!r} (choose from {', '.join(services)})")
    controller = home / args.target / "control"
    # Mutations stay in the checkout the command was run from.
    root = args.root or home.parent
    try:
        os.execv(str(controller), [str(controller), args.action, "--root", str(root), *options])
    except OSError as error:
        print(f"Cannot run {args.target} control: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
